{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RufeShell",
  "version": "1.3.0",
  "identifier": "com.rufeshell.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "RufeShell",
      "label": "main",
      "width": 1440,
      "height": 900,
      "minWidth": 1024,
      "minHeight": 680,
      "decorations": false
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0OTA0N0QxNEMyQTBFRUMKUldUc0RpcE0wVWVRVkVNSjNUVy9ySnBnRjJHaURNYWVhdjgrRDBQaVo2WDhTQTFGVDdzVVZpckIK",
      "endpoints": [
        "https://github.com/520jiyue/RufeShell/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

